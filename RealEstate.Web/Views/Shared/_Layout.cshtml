@using RealEstate.Utility
@{
    var isAdmin = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase)
        || ViewData["AdminShell"] as bool? == true;
    var isAdminUser = User.IsInRole(SD.AdminRole);
    var page = ViewContext.RouteData.Values["page"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isNewProperty = controller == "Property" && action == "Upsert" && ViewContext.RouteData.Values["id"] == null && string.IsNullOrEmpty(Context.Request.Query["id"]);
}
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (isAdmin)
    {
        <title>@(ViewData["Title"] is string adminTitle ? adminTitle + " · " : "")Paneli</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Schibsted+Grotesk:wght@400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/RealEstate.Web.styles.css" asp-append-version="true" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
        <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    }
    else
    {
        <title>@ViewData["Title"] - Emri i Agjencisë</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Schibsted+Grotesk:wght@400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
        <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    }
</head>
<body class="@(isAdmin ? "gd-admin" : null)">
    @if (isAdmin)
    {
        <div class="gd-admin-shell">
            <aside class="gd-side" id="gdSide" aria-label="Menuja e panelit">
                <div class="gd-side-top">
                    <a class="gd-brand" asp-area="Admin" asp-controller="Property" asp-action="Index">Emri i Agjencisë</a>
                    <div class="gd-side-sub">Paneli</div>
                    <button type="button" class="gd-side-close d-md-none" data-gd-side aria-label="Mbyll menunë"><i class="bi bi-x-lg"></i></button>
                </div>
                <nav class="gd-side-nav">
                    <div class="gd-side-group">Pronat</div>
                    <a class="gd-side-link @(controller == "Property" && !isNewProperty ? "active" : null)" asp-area="Admin" asp-controller="Property" asp-action="Index"><i class="bi bi-house-door"></i>Pronat</a>
                    <a class="gd-side-link @(isNewProperty ? "active" : null)" asp-area="Admin" asp-controller="Property" asp-action="Upsert"><i class="bi bi-plus-lg"></i>Shto pronë</a>
                    <div class="gd-side-group">Listat</div>
                    <a class="gd-side-link @(controller == "City" ? "active" : null)" asp-area="Admin" asp-controller="City" asp-action="Index"><i class="bi bi-geo-alt"></i>Qytetet</a>
                    <a class="gd-side-link @(controller == "Neighbourhood" ? "active" : null)" asp-area="Admin" asp-controller="Neighbourhood" asp-action="Index"><i class="bi bi-signpost-2"></i>Lagjet</a>
                    <a class="gd-side-link @(controller == "PropertyType" ? "active" : null)" asp-area="Admin" asp-controller="PropertyType" asp-action="Index"><i class="bi bi-grid"></i>Llojet e pronave</a>
                    <a class="gd-side-link @(controller == "Amenity" ? "active" : null)" asp-area="Admin" asp-controller="Amenity" asp-action="Index"><i class="bi bi-ui-checks-grid"></i>Pajisjet</a>
                    <div class="gd-side-group">Cilësimet</div>
                    <a class="gd-side-link @(controller == "ContactInfo" ? "active" : null)" asp-area="Admin" asp-controller="ContactInfo" asp-action="Index"><i class="bi bi-telephone"></i>Kontakti</a>
                    <a class="gd-side-link @(page == "/Account/Manage/ChangePassword" ? "active" : null)" asp-area="Identity" asp-page="/Account/Manage/ChangePassword"><i class="bi bi-key"></i>Fjalëkalimi</a>
                </nav>
                <div class="gd-side-foot">
                    <a class="gd-side-link" asp-area="Customer" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i>Shiko faqen</a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post">
                        <button type="submit" class="gd-side-link"><i class="bi bi-box-arrow-right"></i>Dil</button>
                    </form>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="gd-side-user" title="@User.Identity.Name">@User.Identity.Name</div>
                    }
                </div>
            </aside>
            <div class="gd-side-backdrop" data-gd-side></div>
            <div class="gd-admin-main">
                <header class="gd-topbar">
                    <button type="button" class="gd-topbar-btn" data-gd-side aria-controls="gdSide" aria-label="Hap menunë"><i class="bi bi-list"></i></button>
                    <a class="gd-brand" asp-area="Admin" asp-controller="Property" asp-action="Index">Emri i Agjencisë</a>
                </header>
                <main role="main" class="gd-admin-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="gd-header sticky-top">
            <nav class="navbar navbar-expand-md">
                <div class="container gd-container">
                    <a class="navbar-brand gd-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">Emri i Agjencisë</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gdNav" aria-controls="gdNav" aria-expanded="false" aria-label="Hap menunë">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <div class="collapse navbar-collapse" id="gdNav">
                        <ul class="navbar-nav ms-md-auto me-md-4 gap-md-3">
                            <li class="nav-item"><a class="nav-link" href="/#te-zgjedhura">Të zgjedhura</a></li>
                            <li class="nav-item"><a class="nav-link" href="/#qytetet">Qytetet</a></li>
                            <li class="nav-item"><a class="nav-link" href="/#te-fundit">Të fundit</a></li>
                            <li class="nav-item"><a class="nav-link" href="#kontakti">Kontakti</a></li>
                            @if (isAdminUser)
                            {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                <ul class="dropdown-menu dropdown-menu-md-end rounded-0">
                                    <li><h6 class="dropdown-header">Pronat</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Property" asp-action="Index">Pronat</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Listat</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="City" asp-action="Index">Qytetet</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Neighbourhood" asp-action="Index">Lagjet</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="PropertyType" asp-action="Index">Llojet e pronave</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Amenity" asp-action="Index">Pajisjet</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Cilësimet</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="ContactInfo" asp-action="Index">Kontakti</a></li>
                                </ul>
                            </li>
                            }
                        </ul>
                        <a class="btn-gd text-decoration-none" href="#kontakti"><i class="bi bi-whatsapp"></i>Na shkruani</a>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @if (ViewData["FullBleed"] as bool? == true)
            {
                @RenderBody()
            }
            else
            {
                <div class="container gd-container gd-page">
                    @RenderBody()
                </div>
            }
        </main>

        <footer class="gd-footer" id="kontakti">
            <div class="container gd-container">
                <div class="row g-5">
                    <div class="col-lg-5">
                        <a class="gd-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">Emri i Agjencisë</a>
                        <p class="mt-3 mb-0">Prona për shitje dhe me qira, të zgjedhura një nga një.</p>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="gd-eyebrow">Kontakti</div>
                        <ul>
                            <li><i class="bi bi-telephone me-2"></i>+355 69 000 0000</li>
                            <li><i class="bi bi-whatsapp me-2"></i>+355 69 000 0000</li>
                            <li><i class="bi bi-envelope me-2"></i>info@agjencia.al</li>
                            <li><i class="bi bi-clock me-2"></i>E Hënë - E Shtunë, 09:00 - 19:00</li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="gd-eyebrow">Rrjetet</div>
                        <ul>
                            <li><a href="#"><i class="bi bi-instagram me-2"></i>Instagram</a></li>
                            <li><a href="#"><i class="bi bi-facebook me-2"></i>Facebook</a></li>
                            <li><a href="#"><i class="bi bi-tiktok me-2"></i>TikTok</a></li>
                        </ul>
                    </div>
                </div>
                <div class="gd-footer-bottom">
                    <span>&copy; 2026 Emri i Agjencisë</span>
                    <span>
                        <a asp-area="Customer" asp-controller="Home" asp-action="Privacy">Privatësia</a>
                        @if (isAdminUser)
                        {
                            <span class="mx-2">·</span>
                            <a asp-area="Admin" asp-controller="Property" asp-action="Index">Paneli</a>
                        }
                    </span>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    @if (isAdmin)
    {
        <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
        <script src="~/js/delete.js"></script>
        <script src="~/js/admin.js" asp-append-version="true"></script>
    }
    <partial name="_Notification"/>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
