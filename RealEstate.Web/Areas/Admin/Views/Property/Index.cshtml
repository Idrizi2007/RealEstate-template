@{
    ViewData["Title"] = "Pronat";
}

<div class="gd-admin-head">
    <div>
        <div class="gd-eyebrow">Paneli</div>
        <h1>Pronat</h1>
    </div>
    <a asp-area="Admin" asp-controller="Property" asp-action="Upsert" class="btn-gd text-decoration-none">
        <i class="bi bi-plus-lg"></i>Shto pronë të re
    </a>
</div>

<div class="gd-toolbar">
    <div class="gd-search">
        <i class="bi bi-search"></i>
        <input type="search" id="propertySearch" class="form-control" placeholder="Kërko sipas REF, titullit ose qytetit…" aria-label="Kërko pronat" />
    </div>
    <div class="gd-amenities" role="group" aria-label="Filtro sipas statusit">
        <input type="radio" class="btn-check" name="statusFilter" id="filterAll" value="all" checked />
        <label class="gd-amenity" for="filterAll">Të gjitha</label>
        <input type="radio" class="btn-check" name="statusFilter" id="filterActive" value="active" />
        <label class="gd-amenity" for="filterActive">Aktive</label>
        <input type="radio" class="btn-check" name="statusFilter" id="filterInactive" value="inactive" />
        <label class="gd-amenity" for="filterInactive">Joaktive</label>
    </div>
    <div class="gd-count" id="propertyCount" aria-live="polite"></div>
</div>

<div class="gd-prop-grid" id="propertyGrid">
    <div class="gd-empty">Duke ngarkuar…</div>
</div>

@section Scripts {
    <script src="~/js/property.js" asp-append-version="true"></script>
}
