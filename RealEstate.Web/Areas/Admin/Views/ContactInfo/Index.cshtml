@model ContactInfo
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Të dhënat e kontaktit</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <div class="border p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="form-floating py-2 col-12 col-md-6">
                        <input asp-for="PhoneNumber" class="form-control border-0 shadow" />
                        <label asp-for="PhoneNumber" class="ms-2"></label>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-floating py-2 col-12 col-md-6">
                        <input asp-for="WhatsAppNumber" class="form-control border-0 shadow" />
                        <label asp-for="WhatsAppNumber" class="ms-2"></label>
                        <span asp-validation-for="WhatsAppNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Email" class="form-control border-0 shadow" />
                    <label asp-for="Email" class="ms-2"></label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Address" class="form-control border-0 shadow" />
                    <label asp-for="Address" class="ms-2"></label>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="OpeningHours" class="form-control border-0 shadow" />
                    <label asp-for="OpeningHours" class="ms-2"></label>
                    <span asp-validation-for="OpeningHours" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Instagram" class="form-control border-0 shadow" />
                    <label asp-for="Instagram" class="ms-2"></label>
                    <span asp-validation-for="Instagram" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Facebook" class="form-control border-0 shadow" />
                    <label asp-for="Facebook" class="ms-2"></label>
                    <span asp-validation-for="Facebook" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="TikTok" class="form-control border-0 shadow" />
                    <label asp-for="TikTok" class="ms-2"></label>
                    <span asp-validation-for="TikTok" class="text-danger"></span>
                </div>

                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">Ruaj</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
