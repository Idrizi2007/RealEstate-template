@using RealEstate.Web.ViewModels
@model NeighbourhoodVM

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@(Model.Neighbourhood.Id != 0 ? "Ndrysho lagjen" : "Shto lagje të re")</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <input asp-for="Neighbourhood.Id" hidden />

            <div class="border p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Neighbourhood.Name" class="form-control border-0 shadow" />
                    <label asp-for="Neighbourhood.Name" class="ms-2">Emri</label>
                    <span asp-validation-for="Neighbourhood.Name" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12">
                    <select asp-for="Neighbourhood.CityId" asp-items="Model.Cities" class="form-select border-0 shadow">
                        <option disabled selected value="">--Zgjidh qytetin--</option>
                    </select>
                    <label asp-for="Neighbourhood.CityId" class="ms-2">Qyteti</label>
                    <span asp-validation-for="Neighbourhood.CityId" class="text-danger"></span>
                </div>

                <div class="form-check py-2 col-12">
                    <input asp-for="Neighbourhood.IsActive" class="form-check-input" />
                    <label asp-for="Neighbourhood.IsActive" class="form-check-label">Aktiv</label>
                </div>

                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">
                            @(Model.Neighbourhood.Id != 0 ? "Ruaj" : "Krijo")
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-area="Admin" asp-controller="Neighbourhood" asp-action="Index" class="btn btn-outline-secondary border form-control">
                            Kthehu
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
