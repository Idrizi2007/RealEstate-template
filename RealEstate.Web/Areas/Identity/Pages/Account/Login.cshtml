@page
@model LoginModel
@{
    ViewData["Title"] = "Hyr";
}

<div class="gd-eyebrow">Paneli</div>
<h1>Hyr</h1>
<p class="gd-auth-lead">Vetëm për administratorin e faqes.</p>

<form id="account" method="post" class="gd-auth-form">
    <div asp-validation-summary="ModelOnly" class="gd-auth-error" role="alert"></div>
    <div class="form-floating">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="emri@shembull.al" autofocus />
        <label asp-for="Input.Email">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="form-floating">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Fjalëkalimi" />
        <label asp-for="Input.Password">Fjalëkalimi</label>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <div class="form-check">
        <input class="form-check-input" asp-for="Input.RememberMe" />
        <label class="form-check-label" asp-for="Input.RememberMe">Më mbaj mend</label>
    </div>
    <button id="login-submit" type="submit" class="btn btn-primary gd-auth-submit">Hyr<i class="bi bi-arrow-right"></i></button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
